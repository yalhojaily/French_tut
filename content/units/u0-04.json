      "type": "dialogue",
      "key": "dialogue",
      "title_ar": "الحوار: في سوق الخضار",
      "context_ar": "زبونة تشتري فواكه من بائع في السوق (le marché). كل كلمة ملوّنة بالأنف: melon و citron (صوت on)، و orange و combien (صوت an)، و un و cinq و demain (صوت in).",
      "speakers": {
        "A": { "name_ar": "البائع", "voice": "male" },
        "B": { "name_ar": "الزبونة", "voice": "female" }
      },
      "lines": [
        { "id": "d1", "speaker": "A", "say": "Bonjour, madame ! Qu'est-ce que vous voulez ?", "ar": "صباح الخير سيدتي! ماذا تريدين؟", "slow": true,
          "gloss": [["Bonjour,", "صباح الخير"], ["madame !", "سيدتي"], ["Qu'est-ce que", "ماذا"], ["vous", "حضرتكِ"], ["voulez ?", "تريدين"]] },
        { "id": "d2", "speaker": "B", "say": "Bonjour ! Je voudrais un melon et cinq oranges.", "ar": "صباح الخير! أريد شمّامة وخمس برتقالات.", "slow": true,
          "gloss": [["Bonjour !", "صباح الخير"], ["Je", "أنا"], ["voudrais", "أودّ"], ["un", "(نكرة)"], ["melon", "شمّام"], ["et", "و"], ["cinq", "خمس"], ["oranges.", "برتقالات"]] },
        { "id": "d3", "speaker": "A", "say": "Très bien. Et avec ça ? Des citrons ?", "ar": "حسناً جداً. وماذا أيضاً؟ ليمون؟", "slow": true,
          "gloss": [["Très bien.", "حسناً جداً"], ["Et", "و"], ["avec", "مع"], ["ça ?", "هذا"], ["Des", "(جمع نكرة)"], ["citrons ?", "ليمون"]] },
        { "id": "d4", "speaker": "B", "say": "Non, merci. C'est combien ?", "ar": "لا، شكراً. بكم؟", "slow": true,
          "gloss": [["Non,", "لا"], ["merci.", "شكراً"], ["C'est", "هذا"], ["combien ?", "بكم"]] },
        { "id": "d5", "speaker": "A", "say": "Cinq euros cinquante.", "ar": "خمسة يوروهات وخمسون سنتاً.", "slow": true,
          "gloss": [["Cinq", "خمسة"], ["euros", "يورو"], ["cinquante.", "خمسون"]] },
        { "id": "d6", "speaker": "B", "say": "Voilà. Bonne journée !", "ar": "تفضّل. يوماً سعيداً!", "slow": true,
          "gloss": [["Voilà.", "تفضّل"], ["Bonne", "سعيد"], ["journée !", "يوم"]] },
        { "id": "d7", "speaker": "A", "say": "Merci, madame. À demain !", "ar": "شكراً سيدتي. إلى الغد!", "slow": true,
          "gloss": [["Merci,", "شكراً"], ["madame.", "سيدتي"], ["À", "إلى"], ["demain !", "الغد"]] }
      ],
      "tip_ar": "قارن **bonjour** (أنفي، بلا نون) مع **bonne** journée (النون منطوقة). السبب: في bonne جاء بعد النون حرف علة (e)، فعادت النون نوناً عادية."
